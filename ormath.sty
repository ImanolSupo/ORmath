% Diagnostics stay at the package boundary, rather than leaking TeX internals.
\msg_new:nnn {ormath}{context}
  { Declaration~'#1'~requires~the~#2~environment. }
\msg_new:nnn {ormath}{option}
  { Unknown~option~'#1'.~Check~the~ORmath~option~reference. }
\msg_new:nnn {ormath}{style}
  { Unknown~style~'#1'.~Define~it~with~\string\ormathstyle. }
\msg_new:nnn {ormath}{nested-style}
  { A~named~style~cannot~contain~style=.~Use~visual~keys~directly. }
\msg_new:nnn {ormath}{set-conflict}
  { Set~'#1'~has~conflicting~representations.~Use~only~one~of~size,~elements,~definition. }
\msg_new:nnn {ormath}{objective}
  { A~model~must~have~exactly~one~objective.~Use~min~or~max. }
\msg_new:nnn {ormath}{unnumbered}
  { Label~'#1'~requires~numbering=rows~or~numbering=model. }
\msg_new:nnn {ormath}{row-label}
  { Row~label~'#1'~requires~numbering=rows.~Use~a~model~label~instead. }
\msg_new:nnn {ormath}{overflow}
  { Row~#1~exceeds~the~available~width.~Use~explicit~\\~breaks,
    ~font-size=small,~or~a~wider~context. }
\msg_new:nnn {ormath}{empty} { The~#1~environment~contains~no~declarations. }
\msg_new:nnn {ormath}{nested} { ORmath~environments~cannot~be~nested. }
\msg_new:nnn {ormath}{dimension}
  { '#1'~must~be~nonnegative;~use~a~nonnegative~dimension. }
\msg_new:nnn {ormath}{element-style}
  { Element~style~key~'#1'~does~not~apply~to~a~row.~Use~it~on~the~environment. }

% Configuration is data. Each layer is parsed before any preset is applied.
\prop_new:N \g__ormath_defaults_prop
\prop_new:N \g__ormath_setup_prop
\prop_new:N \g__ormath_styles_prop
\prop_new:N \l__ormath_config_prop
\prop_new:N \l__ormath_layer_prop
\prop_new:N \l__ormath_saved_layer_prop
\prop_new:N \l__ormath_environment_prop
\prop_gset_from_keyval:Nn \g__ormath_defaults_prop
  {layout=auto,density=compact,font-size=auto,row-gap=2pt,
   space-before=4pt,space-after=4pt,domain-gap=auto,domain-separator={;},
   domain-position=auto,tag-gap=auto,tag-position=auto,extend-left=0pt,extend-right=0pt,
   numbering=rows,subject-to={s.t.}}
\cs_new_protected:Npn \__ormath_config_key:nn #1#2
  { \prop_put:Nnn \l__ormath_layer_prop {#1}{#2} }
\keys_define:nn {ormath/config}
  {
    layout .choices:nn = {auto,wide,stacked}
      {\__ormath_config_key:nn {layout}{#1}},
    density .choices:nn = {relaxed,normal,compact,dense}
      {\__ormath_config_key:nn {density}{#1}},
    font-size .choices:nn = {auto,normal,small,footnotesize,scriptsize}
      {\__ormath_config_key:nn {font-size}{#1}},
    domain-position .choices:nn = {auto,right,below}
      {\__ormath_config_key:nn {domain-position}{#1}},
    tag-position .choices:nn = {auto,right}
      {\__ormath_config_key:nn {tag-position}{#1}},
    tag-gap .code:n = \__ormath_config_key:nn {tag-gap}{#1},
    numbering .choices:nn = {rows,model,none}
      {\__ormath_config_key:nn {numbering}{#1}},
    row-gap .code:n = \__ormath_config_key:nn {row-gap}{#1},
    space-before .code:n = \__ormath_config_key:nn {space-before}{#1},
    space-after .code:n = \__ormath_config_key:nn {space-after}{#1},
    domain-gap .code:n = \__ormath_config_key:nn {domain-gap}{#1},
    domain-separator .code:n = \__ormath_config_key:nn {domain-separator}{#1},
    extend-left .code:n = \__ormath_config_key:nn {extend-left}{#1},
    extend-right .code:n = \__ormath_config_key:nn {extend-right}{#1},
    subject-to .code:n = \__ormath_config_key:nn {subject-to}{#1},
    style .code:n = \__ormath_config_key:nn {style}{#1},
    unknown .code:n = \msg_error:nnx {ormath}{option}{\l_keys_key_str}
  }
\cs_new_protected:Npn \__ormath_preset:n #1
  {
    \str_case:nn {#1}
      {
        {relaxed}{\prop_put_from_keyval:Nn \l__ormath_config_prop
          {row-gap=7pt,space-before=12pt,space-after=12pt,domain-gap=auto}}
        {normal}{\prop_put_from_keyval:Nn \l__ormath_config_prop
          {row-gap=4pt,space-before=8pt,space-after=8pt,domain-gap=auto}}
        {compact}{\prop_put_from_keyval:Nn \l__ormath_config_prop
          {row-gap=2pt,space-before=4pt,space-after=4pt,domain-gap=auto}}
        {dense}{\prop_put_from_keyval:Nn \l__ormath_config_prop
          {row-gap=1pt,space-before=2pt,space-after=2pt,domain-gap=auto}}
      }
  }
\cs_new_protected:Npn \__ormath_apply_layer:
  {
    \prop_get:NnNT \l__ormath_layer_prop {density}\l_tmpa_tl
      {\exp_args:NV \__ormath_preset:n \l_tmpa_tl}
    \prop_map_inline:Nn \l__ormath_layer_prop
      {\str_if_eq:nnF {##1}{style}
        {\prop_put:Nnn \l__ormath_config_prop {##1}{##2}}}
  }
\cs_new_protected:Npn \__ormath_resolve_layer:
  {
    \prop_set_eq:NN \l__ormath_saved_layer_prop \l__ormath_layer_prop
    \prop_get:NnNT \l__ormath_layer_prop {style}\l_tmpa_tl
      {
        \prop_get:NVNTF \g__ormath_styles_prop \l_tmpa_tl \l_tmpb_tl
          {
            \prop_clear:N \l__ormath_layer_prop
            \keys_set:nV {ormath/config}\l_tmpb_tl
            \__ormath_apply_layer:
          }
          {\msg_error:nnV {ormath}{style}\l_tmpa_tl}
      }
    \prop_set_eq:NN \l__ormath_layer_prop \l__ormath_saved_layer_prop
    \__ormath_apply_layer:
  }
% Setup follows ordinary TeX grouping, like other document configuration.
\NewDocumentCommand \ormathsetup {m}
  {
    \prop_set_eq:NN \l__ormath_config_prop \g__ormath_setup_prop
    \prop_clear:N \l__ormath_layer_prop
    \keys_set:nn {ormath/config}{#1}
    \__ormath_resolve_layer:
    \prop_set_eq:NN \g__ormath_setup_prop \l__ormath_config_prop
  }
\NewDocumentCommand \ormathstyle {mm}
  {
    \group_begin:
      \prop_clear:N \l__ormath_layer_prop
      \keys_set:nn {ormath/config}{#2}
      \prop_if_in:NnTF \l__ormath_layer_prop {style}
        {\msg_error:nn {ormath}{nested-style}}
        {\group_end: \prop_put:Nnn \g__ormath_styles_prop {#1}{#2}
         \group_begin:}
    \group_end:
  }

% A record is seven unexpanded fields: kind, expression/symbol, description,
% index domain, label, resolved visual property list, variable type.
% Mathematical and index domains remain distinct. Math is never parsed.
\seq_new:N \l__ormath_records_seq
\tl_new:N \l__ormath_context_tl
\tl_new:N \l__ormath_expression_tl
\tl_new:N \l__ormath_description_tl
\tl_new:N \l__ormath_for_tl
\tl_new:N \l__ormath_label_tl
\tl_new:N \l__ormath_title_tl
\tl_new:N \l__ormath_model_label_tl
\tl_new:N \l__ormath_size_tl
\tl_new:N \l__ormath_elements_tl
\tl_new:N \l__ormath_definition_tl
\tl_new:N \l__ormath_type_tl
\tl_new:N \l__ormath_sense_tl
\int_new:N \l__ormath_objectives_int
\int_new:N \l__ormath_senses_int
\int_new:N \l__ormath_representations_int
\keys_define:nn {ormath/environment}
  {
    title .tl_set:N = \l__ormath_title_tl,
    label .tl_set:N = \l__ormath_model_label_tl,
    unknown .code:n = \exp_args:Nnx \keys_set:nn {ormath/config}
      {\l_keys_key_str={\exp_not:n {#1}}}
  }
\keys_define:nn {ormath/element}
  {
    for .tl_set:N = \l__ormath_for_tl,
    label .tl_set:N = \l__ormath_label_tl,
    font-size .code:n = \keys_set:nn {ormath/config}{font-size=#1},
    row-gap .code:n = \keys_set:nn {ormath/config}{row-gap=#1},
    domain-gap .code:n = \keys_set:nn {ormath/config}{domain-gap=#1},
    tag-gap .code:n = \keys_set:nn {ormath/config}{tag-gap=#1},
    tag-position .code:n = \keys_set:nn {ormath/config}{tag-position=#1},
    domain-separator .code:n = \keys_set:nn {ormath/config}{domain-separator={#1}},
    domain-position .code:n = \keys_set:nn {ormath/config}{domain-position=#1},
    style .code:n = \keys_set:nn {ormath/config}{style=#1},
    unknown .code:n = \msg_error:nnx {ormath}{option}{\l_keys_key_str}
  }
\keys_define:nn {ormath/set}
  {
    size .tl_set:N = \l__ormath_size_tl,
    elements .tl_set:N = \l__ormath_elements_tl,
    definition .tl_set:N = \l__ormath_definition_tl,
    unknown .code:n = \exp_args:Nnx \keys_set:nn {ormath/element}
      {\l_keys_key_str={\exp_not:n {#1}}}
  }
\keys_define:nn {ormath/variable}
  {
    type .choices:nn = {continuous,nonnegative,integer,binary}
      {\tl_set:Nn \l__ormath_type_tl {#1}},
    unknown .code:n = \exp_args:Nnx \keys_set:nn {ormath/element}
      {\l_keys_key_str={\exp_not:n {#1}}}
  }
\keys_define:nn {ormath/objective}
  {
    min .code:n = {\int_incr:N \l__ormath_senses_int\tl_set:Nn \l__ormath_sense_tl {min}},
    max .code:n = {\int_incr:N \l__ormath_senses_int\tl_set:Nn \l__ormath_sense_tl {max}},
    unknown .code:n = \exp_args:Nnx \keys_set:nn {ormath/element}
      {\l_keys_key_str={\exp_not:n {#1}}}
  }
\cs_new_protected:Npn \__ormath_element_begin:nn #1#2
  {
    \prop_set_eq:NN \l__ormath_config_prop \l__ormath_environment_prop
    \prop_clear:N \l__ormath_layer_prop
    \tl_clear:N \l__ormath_for_tl
    \tl_clear:N \l__ormath_label_tl
    \tl_clear:N \l__ormath_type_tl
    \keys_set:nn {ormath/#1}{#2}
    \__ormath_resolve_layer:
    % Styles applied to elements may only set properties that the row consumes.
    \prop_get:NnNT \l__ormath_layer_prop {style}\l_tmpa_tl
      {
        \prop_get:NVNT \g__ormath_styles_prop \l_tmpa_tl \l_tmpb_tl
          {
            \group_begin:
            \prop_clear:N \l__ormath_layer_prop
            \keys_set:nV {ormath/config}\l_tmpb_tl
            \prop_map_inline:Nn \l__ormath_layer_prop
              {\str_case:nnF {##1}{{font-size}{}{row-gap}{}{domain-gap}{}{domain-separator}{}{domain-position}{}{tag-gap}{}{tag-position}{}}
                {\msg_error:nnn {ormath}{element-style}{##1}}}
            \group_end:
          }
      }
  }
\cs_new_protected:Npn \__ormath_store:n #1
  {
    \seq_put_right:Nx \l__ormath_records_seq
      {{#1}{\exp_not:V \l__ormath_expression_tl}
       {\exp_not:V \l__ormath_description_tl}
       {\exp_not:V \l__ormath_for_tl}{\exp_not:V \l__ormath_label_tl}
       {\exp_not:V \l__ormath_config_prop}{\exp_not:V \l__ormath_type_tl}}
  }
\prg_new_conditional:Npnn \__ormath_context:nn #1#2 {T}
  {
    \tl_if_eq:NnTF \l__ormath_context_tl {#2}
      {\prg_return_true:}
      {\tl_if_eq:NnTF \l__ormath_context_tl {notation}
        {\str_case:nnF {#2}
          {{sets}{\prg_return_true:}{parameters}{\prg_return_true:}
           {variables}{\prg_return_true:}}
          {\msg_error:nnnn {ormath}{context}{#1}{or#2}\prg_return_false:}}
        {\msg_error:nnnn {ormath}{context}{#1}{or#2}\prg_return_false:}}
  }
\NewDocumentCommand \orset {O{}mm}
  {
    \__ormath_context:nnT {set}{sets}
      {
        \tl_clear:N \l__ormath_size_tl
        \tl_clear:N \l__ormath_elements_tl
        \tl_clear:N \l__ormath_definition_tl
        \__ormath_element_begin:nn {set}{#1}
        \int_zero:N \l__ormath_representations_int
        \clist_map_inline:nn {size,elements,definition}
          {\tl_if_empty:cF {l__ormath_##1_tl}
            {\int_incr:N \l__ormath_representations_int}}
        \int_compare:nNnTF {\l__ormath_representations_int}>{1}
          {\msg_error:nnn {ormath}{set-conflict}{#2}}
          {
            \tl_set:Nn \l__ormath_expression_tl {#2}
            \tl_if_empty:NF \l__ormath_size_tl
              {\tl_put_right:Nx \l__ormath_expression_tl
                {\exp_not:n {=\{1,2,\ldots,}\exp_not:V \l__ormath_size_tl\exp_not:n {\}}}}
            \tl_if_empty:NF \l__ormath_elements_tl
              {\tl_put_right:Nx \l__ormath_expression_tl
                {\exp_not:n {=\{}\exp_not:V \l__ormath_elements_tl\exp_not:n {\}}}}
            \tl_if_empty:NF \l__ormath_definition_tl
              {\tl_put_right:Nx \l__ormath_expression_tl
                {\exp_not:n {=\{}\exp_not:V \l__ormath_definition_tl\exp_not:n {\}}}}
            \tl_set:Nn \l__ormath_description_tl {#3}
            \__ormath_store:n {set}
          }
      }
  }
\NewDocumentCommand \orparameter {O{}mm}
  {
    \__ormath_context:nnT {parameter}{parameters}
      {\__ormath_element_begin:nn {element}{#1}
       \tl_set:Nn \l__ormath_expression_tl {#2}
       \tl_set:Nn \l__ormath_description_tl {#3}
       \__ormath_store:n {parameter}}
  }
\NewDocumentCommand \orvariable {O{}mm}
  {
    \__ormath_context:nnT {variable}{variables}
      {
        \__ormath_element_begin:nn {variable}{#1}
        \tl_if_empty:NT \l__ormath_type_tl
          {\tl_set:Nn \l__ormath_type_tl {continuous}}
        \tl_set:Nn \l__ormath_expression_tl {#2}
        \tl_set:Nn \l__ormath_description_tl {#3}
        \__ormath_store:n {variable}
      }
  }
\NewDocumentCommand \orobjective {O{min}m}
  {
    \__ormath_context:nnT {objective}{model}
      {
        \tl_clear:N \l__ormath_sense_tl
        \int_zero:N \l__ormath_senses_int
        \__ormath_element_begin:nn {objective}{#1}
        \int_compare:nNnTF {\l__ormath_senses_int}={1}
          {
            \int_incr:N \l__ormath_objectives_int
            \tl_set:Nn \l__ormath_expression_tl {#2}
            \tl_clear:N \l__ormath_description_tl
            \exp_args:NV \__ormath_store:n \l__ormath_sense_tl
          }
          {\msg_error:nn {ormath}{objective}}
      }
  }
\NewDocumentCommand \orconstraint {O{}m}
  {
    \__ormath_context:nnT {constraint}{model}
      {\__ormath_element_begin:nn {element}{#1}
       \tl_set:Nn \l__ormath_expression_tl {#2}
       \tl_clear:N \l__ormath_description_tl
       \__ormath_store:n {constraint}}
  }

