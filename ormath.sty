\box_new:N \l__ormath_expression_box
\box_new:N \l__ormath_domain_box
\box_new:N \l__ormath_marker_box
\box_new:N \l__ormath_number_box
\dim_new:N \l__ormath_width_dim
\dim_new:N \l__ormath_content_dim
\dim_new:N \l__ormath_marker_dim
\dim_new:N \l__ormath_number_dim
\dim_new:N \l__ormath_gap_dim
\dim_new:N \l__ormath_left_dim
\dim_new:N \l__ormath_right_dim
\dim_new:N \l__ormath_before_dim
\dim_new:N \l__ormath_after_dim
\tl_new:N \l__ormath_numbering_tl
\tl_new:N \l__ormath_subject_tl
\tl_new:N \l__ormath_layout_tl
\tl_new:N \l__ormath_position_tl
\tl_new:N \l__ormath_model_number_tl
\int_new:N \l__ormath_row_int
\int_new:N \l__ormath_pending_tag_int
\bool_new:N \l__ormath_first_numbered_bool
\bool_new:N \l__ormath_below_bool
\bool_new:N \l__ormath_first_constraint_bool
\bool_new:N \l__ormath_stacked_bool
\seq_new:N \l__ormath_row_layout_seq
\seq_new:N \l__ormath_tag_extents_seq
\dim_new:N \l__ormath_tag_gap_dim
\dim_new:N \l__ormath_tag_min_dim
\dim_new:N \l__ormath_tag_preferred_dim
\dim_new:N \l__ormath_row_extent_dim
\dim_new:N \l__ormath_tag_end_dim
\dim_new:N \l__ormath_tag_anchor_dim
\dim_new:N \l__ormath_tag_median_dim
\dim_new:N \l__ormath_tag_extension_dim
\int_new:N \l__ormath_preceding_tags_int
\tl_new:N \l__ormath_tag_position_tl
\tl_new:N \l__ormath_tag_gap_tl
\cs_new_protected:Npn \__ormath_font:
  {
    \prop_get:NnN \l__ormath_config_prop {font-size}\l_tmpa_tl
    \str_case:Vn \l_tmpa_tl
      {{normal}{\normalsize}{small}{\small}
       {footnotesize}{\footnotesize}{scriptsize}{\scriptsize}}
  }
\cs_new_protected:Npn \__ormath_dimension:nN #1#2
  {
    \prop_get:NnN \l__ormath_config_prop {#1}\l_tmpa_tl
    % Auto notation retains the established density-dependent prose gap.
    \str_if_eq:nnT {#1}{domain-gap}
      {\str_if_eq:VnT \l_tmpa_tl {auto}
        {\prop_get:NnN \l__ormath_config_prop {density}\l_tmpb_tl
         \str_case:Vn \l_tmpb_tl
           {{relaxed}{\tl_set:Nn\l_tmpa_tl{16pt}}
            {normal}{\tl_set:Nn\l_tmpa_tl{12pt}}
            {compact}{\tl_set:Nn\l_tmpa_tl{8pt}}
            {dense}{\tl_set:Nn\l_tmpa_tl{6pt}}}}}
    \dim_set:Nn #2 {\l_tmpa_tl}
    \dim_compare:nNnT {#2}<{0pt}
      {\msg_error:nnn {ormath}{dimension}{#1}\dim_zero:N #2}
  }
\tl_new:N \l__ormath_math_tl
\cs_new_protected:Npn \__ormath_math_box:Nn #1#2
  {\tl_set:Nn \l__ormath_math_tl {#2}
   % A single outer group shields manual row breaks from the input adapter.
   \tl_if_single:nT {#2}
     {\tl_if_head_is_group:nT {#2}
       {\tl_set:Nx \l__ormath_math_tl {\tl_head:n {#2}}}}
   \hbox_set:Nn #1
     {$\displaystyle\begin{aligned}[t]\tl_use:N\l__ormath_math_tl\end{aligned}$}}
\cs_new_protected:Npn \__ormath_record_config:n #1
  {\tl_set:Nn \l__ormath_config_prop {#1}\__ormath_font:}
\cs_new_protected:Npn \__ormath_environment_begin:nn #1#2
  {
    \tl_if_empty:NF \l__ormath_context_tl {\msg_error:nn {ormath}{nested}}
    \tl_set:Nn \l__ormath_context_tl {#1}
    \seq_clear:N \l__ormath_records_seq
    \int_zero:N \l__ormath_objectives_int
    \tl_clear:N \l__ormath_title_tl
    \tl_clear:N \l__ormath_model_label_tl
    \prop_set_eq:NN \l__ormath_config_prop \g__ormath_defaults_prop
    \prop_set_eq:NN \l__ormath_layer_prop \g__ormath_setup_prop
    \__ormath_apply_layer:
    \prop_clear:N \l__ormath_layer_prop
    \keys_set:nn {ormath/environment}{#2}
    \__ormath_resolve_layer:
    \prop_set_eq:NN \l__ormath_environment_prop \l__ormath_config_prop
  }
\cs_new_protected:Npn \__ormath_render_begin:
  {
    \prop_set_eq:NN \l__ormath_config_prop \l__ormath_environment_prop
    \__ormath_font:
    \__ormath_dimension:nN {extend-left}\l__ormath_left_dim
    \__ormath_dimension:nN {extend-right}\l__ormath_right_dim
    \__ormath_dimension:nN {space-before}\l__ormath_before_dim
    \__ormath_dimension:nN {space-after}\l__ormath_after_dim
    \dim_set:Nn \l__ormath_width_dim
      {\linewidth+\l__ormath_left_dim+\l__ormath_right_dim}
    \prop_get:NnN \l__ormath_config_prop {layout}\l__ormath_layout_tl
    \par\addvspace{\l__ormath_before_dim}
    \int_zero:N \l__ormath_row_int
  }
% Box a title with the first row: penalties alone cannot keep a tall objective
% beside its title at a page boundary. Remaining rows may paginate normally.
\cs_new_protected:Npn \__ormath_title_begin:
  {
    \int_compare:nNnT {\l__ormath_row_int}={1}
      {\tl_if_empty:NF \l__ormath_title_tl
        {\vbox\bgroup
         \noindent\textbf{\l__ormath_title_tl}\par\smallskip}}
  }
\cs_new_protected:Npn \__ormath_title_end:
  {
    \int_compare:nNnT {\l__ormath_row_int}={1}
      {\tl_if_empty:NF \l__ormath_title_tl {\egroup}}
  }
\cs_new_protected:Npn \__ormath_render_end:
  {\par\addvspace{\l__ormath_after_dim}}
\cs_new_protected:Npn \__ormath_label:n #1
  {\tl_if_blank:nF {#1}{\label{#1}}}
\cs_new_protected:Npn \__ormath_model_numbering:
  {
    \prop_get:NnN \l__ormath_config_prop {numbering}\l__ormath_numbering_tl
    \prop_get:NnN \l__ormath_config_prop {subject-to}\l__ormath_subject_tl
    \dim_zero:N \l__ormath_number_dim
    \tl_clear:N \l__ormath_model_number_tl
    \str_if_eq:VnF \l__ormath_numbering_tl {none}
      {
